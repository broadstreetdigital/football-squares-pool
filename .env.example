# Application Settings
NODE_ENV=development

# JWT Secret (REQUIRED in production - generate with: openssl rand -base64 32)
# Add this to Vercel Environment Variables for production
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Turso Database (REQUIRED - get from https://turso.tech)
# Add these to Vercel Environment Variables for production
# Create a database at: https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# SendGrid Email (OPTIONAL - for transactional emails)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# Add these to Vercel Environment Variables for production
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@footballsquarespool.com

# Site URL (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
